language js

or {
  `width < $n`,
  `width <= $n`,
  `width > $n`,
  `width >= $n`,
  `$n < width`,
  `$n <= width`,
  `$n > width`,
  `$n >= width`
} where {
  $n <: r"[1-9][0-9]{2,}",
  register_diagnostic(
    span = $n,
    message = "A literal width here goes stale when the edge moves, as #86's width < 700 did. Take it from src/viewport.ts or phoneGridMaxWidth."
  )
}
