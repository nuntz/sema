language js

or {
  `expect(await $locator.evaluate($...))`,
  `expect($read)` where { $read <: contains `$locator.boundingBox()` }
} as $oneShot where {
  register_diagnostic(
    span = $oneShot,
    message = "A one-shot read passes or fails on whatever the page shows at that instant. Poll it: expect.poll(() => locator.evaluate(…)), or expect.poll(() => locator.boundingBox())."
  )
}
