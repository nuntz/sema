{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "e2e/**/*.ts",
      "vite.config.ts",
      "playwright.config.ts"
    ]
  },
  "plugins": [
    "./biome-plugins/no-fixed-sleep.grit",
    "./biome-plugins/no-one-shot-evaluate.grit",
    "./biome-plugins/no-exact-state-log.grit"
  ],
  "overrides": [
    {
      "includes": ["e2e/**/*.e2e.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@playwright/test": "Import from \"./test\", which carries SEMA_E2E_STRESS to every page."
                }
              }
            }
          }
        }
      }
    }
  ]
}
